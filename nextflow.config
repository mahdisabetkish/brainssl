/*
 * brainssl: pipeline configuration
 *
 * Parameters can be overridden on the command line (--smri_workers 4) or in a
 * params file (-params-file my_params.yaml). Profiles combine with commas:
 *
 *   -profile docker,gpu
 *   -profile slurm,apptainer,gpu
 *   -profile test,docker
 */

manifest {
    name            = 'mahdisabetkish/brainssl'
    author          = 'Mahdi Sabet Kish'
    homePage        = 'https://github.com/mahdisabetkish/brainssl'
    description     = 'Label-efficient learning on brain MRI and fMRI: a bilateral U-Net for tumour segmentation and noise-aware connectome classifiers'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0.0'
}

params {
    // Input. Point raw at an existing data/raw to skip the download.
    raw              = null
    tracks           = 'smri,fmri'     // run one track with --tracks smri

    // Run matrices: one row per run; adding a run is a new row.
    smri_runs        = "${projectDir}/assets/smri_runs.csv"
    fmri_methods     = "${projectDir}/assets/fmri_methods.csv"
    fmri_choices     = "${projectDir}/assets/fmri_choices.json"   // C of the noise-aware model, fixed from development runs

    // Segmentation
    smri_workers     = 8
    smri_extra_args  = ''              // appended to every finetune/pretrain call, e.g. 'lr_width=32'
    smri_finetune_args = ''            // appended to finetune calls only, e.g. 'val_every=500'
    smri_iter_scale  = 1.0             // multiplies the iteration counts of the matrix

    // Connectomes
    fmri_atlases     = 'aal ho dosenbach160 cc200 cc400'
    fmri_repeats     = 5
    fmri_folds       = 10

    // Trust and interpretability audits (see docs/trust.md)
    trust_budgets          = '10pct,100pct'          // label budgets whose proposed and scratch runs are audited
    trust_robust_cases     = 24                      // test scans put through the perturbations
    trust_bootstraps       = 30                      // refits of the connectome classifier for the stability analysis
    trust_stability_atlases = 'aal ho dosenbach160 cc200'
    trust_deletion_atlases = 'aal'

    // Export and report
    export           = true
    showcase_cases   = "${projectDir}/assets/showcase_cases.json"   // scans shown in the dashboard's viewer

    // Hardware
    gpu              = false
    container_repo   = 'docker.io/mahdisabetkish/brainssl'
    cluster_options  = ''
    max_cpus         = 16
    max_memory       = '48.GB'
    max_time         = '24.h'

    // Output
    outdir           = 'results'
    publish_dir_mode = 'copy'

    // Synthetic data (-profile test)
    test             = false
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }
    conda {
        conda.enabled    = true
        process.conda    = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g) --shm-size=4g'
        process.container = "${params.container_repo}:${params.gpu ? 'gpu' : 'cpu'}"
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = "docker://${params.container_repo}:${params.gpu ? 'gpu' : 'cpu'}"
    }
    gpu {
        params.gpu           = true
        docker.runOptions    = '-u $(id -u):$(id -g) --shm-size=4g --gpus all'
        apptainer.runOptions = '--nv'
        process {
            withLabel: 'process_gpu' {
                accelerator = 1
                maxForks    = 1
            }
        }
    }
    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = { params.cluster_options }
        executor.queueSize     = 20
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
