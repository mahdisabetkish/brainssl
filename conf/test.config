/*
 * -profile test: synthetic data, tiny networks, two iterations per run.
 * Every stage and every row of both run matrices executes, in a few minutes on
 * a CPU, which is what CI runs on each push. It checks the plumbing, not the
 * science.
 */

params {
    test            = true
    smri_workers    = 0
    smri_iter_scale = 0.00007           // 30000 iterations become 2
    smri_extra_args = 'lr_width=32 patch=[32,32] channels=[4,8,16] log_every=1 save_every=1 batch=2'
    smri_finetune_args = 'val_every=2 val_cases=2'
    fmri_atlases    = 'cc200 aal'
    fmri_choices    = "${projectDir}/assets/test/fmri_choices.json"
    fmri_repeats    = 1
    fmri_folds      = 2
    showcase_cases  = "${projectDir}/assets/test/showcase_cases.json"
    trust_budgets   = '10pct'
    trust_robust_cases = 3
    trust_bootstraps = 3
    trust_stability_atlases = 'aal'
    max_cpus        = 2
    max_memory      = '6.GB'
    max_time        = '1.h'
    gpu             = false
}

// the profile's max_cpus is read before the profile is applied, so the limits are set here as well
process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
