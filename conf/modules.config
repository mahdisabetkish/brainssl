/*
 * Where each process publishes its outputs under --outdir. Run directories
 * keep the same layout as a local run (runs/smri/<tag>, runs/fmri/<method>),
 * so the report and dashboard scripts read either.
 */

process {
    withName: 'MAKE_TEST_DATA|DOWNLOAD' {
        publishDir = [path: { "${params.outdir}/raw" }, mode: 'symlink', enabled: false]
    }
    withName: 'PREPARE_MSD|PREPARE_ABIDE' {
        publishDir = [path: { "${params.outdir}/processed" }, mode: params.publish_dir_mode]
    }
    withName: 'SMRI_PRETRAIN|SMRI_FINETUNE|SMRI_EVALUATE' {
        publishDir = [path: { "${params.outdir}/runs/smri" }, mode: params.publish_dir_mode,
                      saveAs: { name -> name.endsWith('.log') ? null : name }]
    }
    withName: 'FMRI_STUDY|FMRI_DEEP' {
        publishDir = [path: { "${params.outdir}/runs/fmri" }, mode: params.publish_dir_mode]
    }
    withName: 'EXPORT_MODELS' {
        publishDir = [path: { "${params.outdir}/exports" }, mode: params.publish_dir_mode]
    }
    withName: 'REPORT' {
        publishDir = [path: { "${params.outdir}" }, mode: params.publish_dir_mode]
    }
    withName: 'DASHBOARD' {
        publishDir = [path: { "${params.outdir}/dashboard" }, mode: params.publish_dir_mode]
    }
}
