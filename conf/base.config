/*
 * Resources per process label. resourceLimits caps every request at
 * --max_cpus, --max_memory and --max_time, so the same labels work on a laptop
 * and on a cluster. Training tasks ask for a GPU when the gpu profile is on.
 */

process {
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory, time: params.max_time]

    cpus          = { 2 * task.attempt }
    memory        = { 8.GB * task.attempt }
    time          = { 2.h * task.attempt }
    errorStrategy = { task.exitStatus in [137, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2
    shell         = ['/bin/bash', '-euo', 'pipefail']

    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: 'process_data' {
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_gpu' {
        cpus        = 10
        memory      = { 24.GB * task.attempt }
        time        = { 12.h * task.attempt }
        maxForks    = 2                      // the gpu profile lowers this to one
    }
}
